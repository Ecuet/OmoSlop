import "assets/Notosans-Regular.ttf";
import { DefaultButton, AnimatedImage } from "components.slint";
import { BaseWindow } from "base-window.slint";

import {
    Button,
    Slider,
    VerticalBox,
    ScrollView,
    AboutSlint,
    LineEdit,
    HorizontalBox,
    CheckBox,
    ListView,
} from "std-widgets.slint";
export component GifWindow inherits Window {
    callback MoveWindow(length, length);
    callback Close();

    in-out property <length> ImageXWidth: 100px;
    in-out property <length> ImageXHeight: 100px;

    in-out property <image> currentImage;

    in-out property <[image]> frames;
    in-out property <int> currentImageIndex: 0;

    in-out property <bool> Locked;

    in-out property <int> id;

    in-out property <bool> closing_allowed: false;

    max-width: root.ImageXWidth;
    max-height: root.ImageXHeight;

    min-width: root.ImageXWidth;
    min-height: root.ImageXHeight;

    no-frame: true;
    background: transparent;

    full-screen: false;
    always-on-top: true;

    title: "Overlay";

    TouchArea {
        enabled: !Locked;
        moved => {
            MoveWindow(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y)
        }
    }

    Image {
        source: root.frames[currentImageIndex];
        width: 100%;
        height: 100%;
    }

    Close => {
        self.close();
    }
}

export component MainWindowTray inherits SystemTrayIcon {
    callback quit();
    callback show();

    icon: @image-url("assets/icon.png");
    tooltip: "OmoSlop";

    Menu {
        MenuItem {
            title: "Show";
            activated => {
                show();
            }
        }

        MenuItem {
            title: "Quit";
            activated => {
                quit();
            }
        }
    }

    clicked => {
        show();
    }
}

export component SettingsParamBackground {
    in-out property <string> title;

    Rectangle {
        width: parent.width;
        height: parent.height * 0.15;

        Text {
            x: 0px;
            width: parent.width * 0.5;

            wrap: TextWrap.word-wrap;

            text: title;

            font-family: "Noto Sans";
            font-size: 15px;

            horizontal-alignment: left;
            color: lightgray;
        }

        Rectangle {
            width: parent.width * 0.4;
            height: parent.height;

            y: 0; //parent.height * 0.5;
            x: parent.width * 0.5;

            @children
        }
    }
}

export component SettingsWindow inherits Window {
    callback ScaleChanged(float);
    callback LockChanged(bool);

    default-font-family: "Noto Sans";

    min-width: 410px;
    min-height: 550px;

    max-width: 410px;
    max-height: 550px;

    title: "Settings";

    VerticalBox {
        height: 90%;
        width: 90%;

        alignment: center;

        ScrollView {
            height: 100%;
            width: 100%;

            content-height: 500px;

            VerticalBox {
                width: 100%;
                height: 100%;
                SettingsParamBackground {
                    height: 50px;
                    title: "Scale of the overlay: ";

                    Slider {
                        minimum: 0;
                        maximum: 10;
                        min-height: 15px;
                        min-width: parent.width / 2;
                        step: 0.05;
                        value: 1;

                        changed(value) => {
                            ScaleChanged(value);
                        }
                    }
                }

                SettingsParamBackground {
                    height: 50px;
                    title: "Lock Overlay Position: ";

                    CheckBox {
                        x: 0;

                        toggled() => {
                            LockChanged(self.checked);
                        }
                    }
                }
            }
        }
    }
}

export component SelectGifButton {
    callback Clicked();

    in-out property <string> text;

    in-out property <[image]> frames;

    Rectangle {
        width: 100px;
        height: 100px;

        clip: true;

        background: gray;

        AnimatedImage {
            is_running: root.visible;
            width: parent.width;
            height: parent.height;
            x: 0;
            y: 0;

            frames: frames;
        }

        Text {
            text: text;
          //  wrap: TextWrap.word-wrap;
            
            x: 0;
            y: 0;

            horizontal-alignment: center;
            vertical-alignment: center;

            width: 100%;
            height: 100%;
        }

        Button {
            width: 100%;
            height: 100%;

            clicked => {
                Clicked();
            }
        }
    }
}

export struct ImageData { name: string, frames: [image] }
export component MainWindow inherits Window {
    callback FileChooser();
    callback OpenSettings();

    callback AddOverlay(string);
    callback RemoveOverlay(string);

    callback ChangeScale(string, float);
    callback LockChanged(string, bool);

    callback UpdateUIOverlaySettings(string);

    callback DeleteFromList(string);

    in-out property <bool> ui_Lock;
    in-out property <float> ui_Scale;

    in-out property <string> current_selected_image: "";
    property <[image]> current_selected_image_frames;

    in-out property <[ImageData]> ImagesData;

    in-out property <bool> ClosedNotificationShown: false;

    property <int> max_rows : max(1, floor((self.width * 0.6) / 105px));
    
    title: "OmoSlop";

    preferred-height: 600px;
    preferred-width: 1000px;

    min-height: 480px;
    min-width: 620px;

    icon: @image-url("assets/icon.png");

    VerticalLayout {
        width: 80%;
        height: 10%;

        y: 0px;
        alignment: center;
        cross-axis-alignment: end;

        DefaultButton {
            visible: false;
            text: "Settings";

            clicked => {
                OpenSettings();
            }
        }
    }

    ScrollView {
        width: 60%;
        height: 80%;

        x: 10px;

        content-height: root.ImagesData.length * (45px / 2);
        // padding-top: 40px;
        // padding-left: 35px;

        // spacing: 75px;

        // alignment: start;
        // cross-axis-alignment: CrossAxisAlignment.start;

        SelectGifButton {
            text: "Add Image";

            x: 45px;
            y: 50px;

            Clicked => {
                FileChooser();
            }
        }

        for data[i] in root.ImagesData: SelectGifButton {
            x: mod(i, max_rows) * 105px + 45px; 
            y: floor(i / max_rows) * 105px + 50px;

            visible: i != 0;

            text: "";
            frames: data.frames;

            Clicked => {
                current_selected_image = data.name;
                current_selected_image_frames = data.frames;

                UpdateUIOverlaySettings(data.name);
            }
        }
        
    }

    ScrollView {
        visible: current_selected_image != "";
        VerticalBox {
            width: 40%;
            alignment: LayoutAlignment.stretch;
            cross-axis-alignment: CrossAxisAlignment.center;
            height: 80%;

            x: root.width - self.width - 10px;

            Rectangle {
                width: parent.width;
                height: parent.height * 0.5;

                Rectangle {
                    // x: parent.width / 2;
                    // y: parent.height / 2;
                    
                    background: gray;

                    width: parent.height < parent.width ? parent.height : parent.width;
                    height: self.width;

                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;

                    AnimatedImage {
                        is_running: root.visible;
                        frames: current_selected_image_frames;
                        width: 100%;
                        height: 100%;
                    }
                }
            }

            Rectangle {
                height: 5%;
                width: 100%;

                HorizontalBox {
                    cross-axis-alignment: center;
                    alignment: center;

                    DefaultButton {
                        width: 5%;
                        height: 5%;
                        text: "Add";

                        clicked => {
                            AddOverlay(current_selected_image);
                        }
                    }

                    DefaultButton {
                        width: 5%;
                        height: 5%;
                        text: "Remove";

                        clicked => {
                            RemoveOverlay(current_selected_image);
                        }
                    }
                }
            }

            SettingsParamBackground {
                width: 100%;
                height: 50px;
                title: "Scale of the overlay:";
                Slider {
                    minimum: 0;
                    maximum: 10;
                    min-height: 15px;

                    width: parent.width / 2;

                    step: 0.05;
                    value <=> root.ui_Scale;

                    changed(value) => {
                        ChangeScale(current_selected_image, value);
                    }
                }
            }

            SettingsParamBackground {
                width: 100%;
                height: 50px;
                title: "Lock Overlay Position: ";

                CheckBox {
                    x: 0;

                    checked <=> root.ui_Lock;

                    toggled() => {
                        LockChanged(current_selected_image, self.checked);
                    }
                }
            }

            DefaultButton {
                text: "Delete from list";
                
                clicked => {
                    DeleteFromList(current_selected_image)
                }
            }
        }
    }

    
}
